<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the locally signed personal build.

  Identical to OpenIslandApp.entitlements plus library validation disabled.
  The hardened runtime enforces that every loaded library carries the same
  Team ID as the main binary; a self-signed local certificate has no Team ID
  at all, so Sparkle.framework fails that check and the app aborts at launch
  with "different Team IDs". A Developer ID build does not need this, which
  is why the release entitlements file stays untouched.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!--
      Required to ask for the camera at all. Under the hardened runtime macOS
      refuses to even show the permission dialog without this, and denies
      immediately — tccd says so plainly:

        Prompting policy for hardened runtime; service: kTCCServiceCamera
        requires entitlement com.apple.security.device.camera but it is missing
        Policy disallows prompt ... access to kTCCServiceCamera denied

      The usage description in Info.plist is necessary but not sufficient.
    -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!--
      Required to ask for the microphone at all. Under the hardened runtime
      macOS refuses to show the permission dialog without this and denies on
      the spot — exactly what happened with the camera before
      com.apple.security.device.camera was added.
    -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
